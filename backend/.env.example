NODE_ENV=development
PORT=3000
DB_URL=postgresql://user:password@host/neondb?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=molo_restaurant
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=replace_with_random_webhook_secret
TELEGRAM_WEB_APP_URL=https://your-frontend-domain.example
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600

JWT_SECRET=change_me_to_long_random_secret
JWT_EXPIRES_IN=30d
ALLOW_DEV_AUTH=true

# Guest Web Push stays off until the production migration and sender are approved.
GUEST_PUSH_ENABLED=false
GUEST_PUSH_VAPID_PUBLIC_KEY=
GUEST_PUSH_VAPID_PRIVATE_KEY=
GUEST_PUSH_VAPID_SUBJECT=

# Syrve stays inactive until the Director configures it. Backend secrets only.
# Required to test/save Syrve credentials in production; use a separate random secret.
SYRVE_CREDENTIALS_SECRET=
# Configure BOTH values for current Syrve v2 authentication (Developer Portal).
# If both are absent, the existing deprecated API-login v1 flow is retained.
SYRVE_APP_ID=
SYRVE_APP_CLIENT_SECRET=
