NODE_ENV=production
PORT=3000

DB_HOST=YOUR_DB_HOST
DB_PORT=5432
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=YOUR_DB_NAME
DB_SYNCHRONIZE=false

JWT_SECRET=CHANGE_THIS_SECRET
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=CHANGE_THIS_WEBHOOK_SECRET
TELEGRAM_WEB_APP_URL=https://YOUR_FRONTEND_DOMAIN
CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN
ALLOW_DEV_AUTH=false

# Keep disabled until the production migration and sender are explicitly approved.
GUEST_PUSH_ENABLED=false
GUEST_PUSH_VAPID_PUBLIC_KEY=
GUEST_PUSH_VAPID_PRIVATE_KEY=
GUEST_PUSH_VAPID_SUBJECT=